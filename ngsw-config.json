{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/sitemap.xml"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.csr.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "my-trips",
      "urls": ["/api/trips", "/api/trips/*", "/api/trips/*/days/*/weather"],
      "cacheConfig": { "strategy": "freshness", "timeout": "5s", "maxAge": "30d", "maxSize": 60 }
    },
    {
      "name": "guides",
      "urls": ["/api/guides", "/api/guides/*", "/api/trips/shared/*"],
      "cacheConfig": { "strategy": "freshness", "timeout": "5s", "maxAge": "7d", "maxSize": 150 }
    },
    {
      "name": "place-photos",
      "urls": ["/api/places/photo**"],
      "cacheConfig": { "strategy": "performance", "maxAge": "30d", "maxSize": 400 }
    }
  ]
}
